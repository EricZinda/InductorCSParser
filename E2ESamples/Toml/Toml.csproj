<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>InductorParser.E2ESamples.Toml</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Tomlyn is the BSD-2-Clause C# reference TOML parser. We pull it in
         via NuGet (not via copied source) so the comparison tests always
         diff against the published library, not a snapshot we'd have to keep
         in sync. See Original/NOTICE.md for the rationale. -->
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InductorParser\InductorParser.csproj" />
  </ItemGroup>

</Project>
