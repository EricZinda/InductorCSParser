<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PermutationSample</RootNamespace>
    <AssemblyName>PermutationSample</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InductorParser\InductorParser.csproj" />
  </ItemGroup>

  <!--
    Original/ holds the upstream-style reference program. It's Haskell, not a
    .NET source file, so it isn't compiled (the SDK only globs *.cs anyway;
    this is belt-and-suspenders).
  -->
  <ItemGroup>
    <None Include="Original\parsec_perm_example.hs" />
  </ItemGroup>

</Project>
