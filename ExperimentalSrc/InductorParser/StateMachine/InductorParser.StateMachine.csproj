<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>InductorParser.StateMachine</RootNamespace>
    <AssemblyName>InductorParser.StateMachine</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- See InductorParser.csproj for the rationale on the doc-file
         settings. The same applies here: ship XML doc next to the DLL,
         suppress CS1591 because public API docs are added type-by-type. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\InductorParser\InductorParser.csproj" />
    <!-- Lowerer.DisableLookaheadShortcut is internal and gets flipped by
         the test fixture and the rebar benchmark for A/B-measuring the
         StateMachine's lookahead-skip optimization. The Tests assembly
         also constructs LoweringContext and friends directly in
         Lowerer-level unit tests. -->
    <InternalsVisibleTo Include="InductorParser.StateMachine.Tests" />
    <InternalsVisibleTo Include="InductorParser.RebarRunner" />
    <InternalsVisibleTo Include="InductorParser.StateMachine.Benchmarks" />
  </ItemGroup>

</Project>
