<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>InductorParser.Benchmarks.Rebar</RootNamespace>
    <AssemblyName>InductorParser.RebarRunner</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\InductorParser\InductorParser.csproj" />
    <!-- BenchmarkPlan.cs has a bool _useStateMachine flag and dispatches
         to StateMachineParser when set. Hooked up here so the
         "inductorparser-statemachine" engine name in Program.cs
         actually has somewhere to route. -->
    <ProjectReference Include="..\..\InductorParser\StateMachine\InductorParser.StateMachine.csproj" />
    <!-- Required-literal prefilter analysis. BenchmarkPlan.CompileScanner
         uses TryGetRequiredLiteral / TryGetRequiredLiteralAlternatives
         (extension methods on Rule from this project) as a grep
         pre-scan trigger to skip non-matching lines before invoking
         the parser. -->
    <ProjectReference Include="..\..\InductorParser.Prefilter\InductorParser.Prefilter.csproj" />
  </ItemGroup>

</Project>
