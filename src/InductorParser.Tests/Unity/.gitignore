# Unity-generated artifacts. ProjectSettings/ and Packages/manifest.json
# are committed; everything else Unity creates is derived output.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity resolves Packages/packages-lock.json from manifest.json on open;
# not committed to keep the scaffold minimal.
Packages/packages-lock.json

# IDE clutter.
.vs/
.idea/
.vsconfig
*.csproj
*.sln
!Unity.slnx

# Artifacts from the IL2CPP test build.
Build/

# Test sources synced in from src/InductorParser.Tests/ by runil2cpptest.sh.
# The .NET test project is the single source of truth; this tree is
# recreated on each run. Unity generates .meta files next to each synced
# .cs on import; they live and die with the folder.
Assets/Tests/PlayMode/Synced/
Assets/Tests/PlayMode/Synced.meta

# Prolog fixture corpus synced in by syncteststounity.sh for
# PrologGrammarTests, which reads it from AppContext.BaseDirectory (the
# Unity project root under the test runner). Outside Assets/ so Unity
# doesn't import it.
E2EExamples/

# Init scenes Unity drops into Assets/ when launching PlayMode tests in
# batch mode. Filename has a per-run GUID; safe to ignore everywhere.
Assets/InitTestScene*.unity
Assets/InitTestScene*.unity.meta
