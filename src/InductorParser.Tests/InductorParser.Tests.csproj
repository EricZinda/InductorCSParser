<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(InductorParserTestFrameworks)' == ''">net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(InductorParserTestFrameworks)' != ''">$(InductorParserTestFrameworks)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <!-- The normalization oracle. The tests compare the built-in
       normalizer against string.Normalize, which hands the work to
       whatever ICU the machine has (system ICU on Linux, the OS
       icu.dll on Windows), and that data moves with OS updates. This
       package puts ICU 72.1's native DLLs in the test output (under
       runtimes/<platform>/native/), and the AppLocalIcu option makes
       the runtime load that copy instead of the OS one, so every test
       run normalizes from the same bytes. ICU 72.1 is Unicode 15.0
       data while the built-in tables are Unicode 16.0. It stays the
       oracle because no newer app-local ICU package exists, and the
       normalization stability policy makes the two versions agree on
       every code point assigned through 15.0. The sweeps skip the
       code points 16.0 added (UnicodeVersionDelta), and the
       NormalizationTest-16.0.0.txt conformance suite covers those.
       GlobalizationOracleFixture refuses to run the suite if this ICU
       isn't the one actually loaded. The RuntimeHostConfigurationOption
       flows into the generated runtimeconfig.json, which the test
       host honors. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InductorParser\InductorParser.csproj" />
  </ItemGroup>

  <!-- Build-order only: HostGlobalizationChildProcessTests launches
       this console app with dotnet exec from the child's own output
       folder, where its dll, deps.json, and runtimeconfig.json are
       guaranteed to sit together (whether a referenced exe's
       runtimeconfig gets copied here has varied across SDK versions,
       so the tests don't rely on this project's output at all).
       ReferenceOutputAssembly=false keeps the child's types out of
       this assembly while still making every build of the tests build
       the child first. -->
  <ItemGroup>
    <ProjectReference Include="..\InductorParser.Tests.GlobalizationChild\InductorParser.Tests.GlobalizationChild.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The state-machine engine's test project, which lives in its own
       repo, shares fixtures from this project (TraceTestHelpers,
       UnicodeExamples, ChordGrammar, BacklogGrammar) which are
       internal. Granting it visibility here lets it use those types
       directly without having to either duplicate them or expose them
       as public to all consumers of InductorParser.Tests. The grant is
       harmless when that project is not present. -->
  <ItemGroup>
    <InternalsVisibleTo Include="InductorParser.StateMachine.Tests" />
  </ItemGroup>

  <!-- The Unity/ subfolder is its own self-contained Unity project for the
       IL2CPP smoke test (see docs/TestArchitecture.md). Its Library/ contains
       package-cache C# files that Unity regenerates on open; the SDK's default
       **/*.cs glob would otherwise pull them into the dotnet-test build and
       break compilation on machines where Unity has been opened. Exclude the
       whole subtree from this project's compilation. -->
  <ItemGroup>
    <Compile Remove="Unity\**" />
    <None Remove="Unity\**" />
    <EmbeddedResource Remove="Unity\**" />
  </ItemGroup>

  <!-- Real-world Prolog / HTN fixture files from the InductorHtn repo
       (MIT licensed, see the note in PrologGrammarTests.cs for authorship),
       used as end-to-end parse corpus for PrologGrammarTests. Copied to
       the test output directory so tests can read them as plain files. -->
  <ItemGroup>
    <None Include="E2EExamples\PrologFixtures\*.htn;E2EExamples\PrologFixtures\*.pl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Official Unicode conformance test files (verbatim from
       unicode.org/Public). Copied to the test output directory so the
       conformance fixtures can read them as plain files at run time.
       See GraphemeBreakConformanceTests.cs for the UAX #29 suite. -->
  <ItemGroup>
    <None Include="Lexing\UnicodeConformance\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The checked-in generated Unicode data files, copied (not
       compiled, they already compile inside InductorParser) so the
       data-table fixtures can run the embedded emitter against the
       checked-in tables and require the output to reproduce each file
       line for line. That round-trip catches drift between a data
       file and the generator that claims to produce it, with no
       network. See Checked_in_data_file_matches_what_the_emitter_produces
       in UnicodeNormalizationDataTests.cs and
       GraphemeSegmentationDataTests.cs. -->
  <ItemGroup>
    <None Include="..\InductorParser\Lexing\Unicode\UnicodeNormalization.Data.cs" Link="CheckedInData\UnicodeNormalization.Data.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\InductorParser\Lexing\Unicode\GraphemeSegmentation.Data.cs" Link="CheckedInData\GraphemeSegmentation.Data.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
