<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InductorParser\InductorParser.csproj" />
  </ItemGroup>

  <!-- The state-machine test project in ExperimentalSrc/ shares
       fixtures from this project (TraceTestHelpers, UnicodeExamples,
       ChordGrammar, BacklogGrammar) which are internal. Granting it
       visibility here lets it use those types directly without having
       to either duplicate them or expose them as public to all
       consumers of InductorParser.Tests. The grant is harmless when
       ExperimentalSrc is not present. -->
  <ItemGroup>
    <InternalsVisibleTo Include="InductorParser.StateMachine.Tests" />
  </ItemGroup>

  <!-- The Unity/ subfolder is its own self-contained Unity project for the
       IL2CPP smoke test (see docs/TestArchitecture.md). Its Library/ contains
       package-cache C# files that Unity regenerates on open; the SDK's default
       **/*.cs glob would otherwise pull them into the dotnet-test build and
       break compilation on machines where Unity has been opened. Exclude the
       whole subtree from this project's compilation. -->
  <ItemGroup>
    <Compile Remove="Unity\**" />
    <None Remove="Unity\**" />
    <EmbeddedResource Remove="Unity\**" />
  </ItemGroup>

  <!-- Real-world Prolog / HTN fixture files from the InductorHtn repo,
       used as end-to-end parse corpus for PrologGrammarTests. Copied to
       the test output directory so tests can read them as plain files. -->
  <ItemGroup>
    <None Include="E2EExamples\PrologFixtures\*.htn;E2EExamples\PrologFixtures\*.pl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
