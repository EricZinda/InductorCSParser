<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>InductorParser</RootNamespace>
    <AssemblyName>InductorParser</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Emit an XML doc file next to the DLL so IntelliSense can show
         /// doc comments to consumers who reference the assembly
         directly. CS1591 ("missing XML comment for publicly visible
         type or member") is suppressed because public API docs are
         being added type-by-type. Without this, every undocumented
         public member would fail the build under TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata. `dotnet pack -c Release` produces
       InductorParser.<version>.nupkg with both target frameworks and
       the XML doc file inside. The version comes from the
       ComputeVersionFromGit target below, same as the DLL's
       FileVersion, so a package and the DLL inside it always agree.
       The release workflow (.github/workflows/release.yml) runs the
       pack and pushes the result to nuget.org when a version tag is
       pushed. The license and readme are packed in from the repo root
       so nuget.org can show them on the package page. nuget.org can't
       resolve relative links, so every link in the readme is an
       absolute URL (docs pages on the published site, the chart image
       from the site's images/ folder, everything else on GitHub). -->
  <PropertyGroup>
    <PackageId>InductorParser</PackageId>
    <Authors>Eric Zinda</Authors>
    <Description>A PEG parser library where grammars are readable rules instead of regex. Designed around Unicode, safe against pathological input by default, and able to run under Unity IL2CPP and WebGL.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageProjectUrl>https://ericzinda.github.io/InductorCSParser/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/EricZinda/InductorCSParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>parser;parsing;grammar;unicode;regex;unity;PEG;C#</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Unicode implementation default: what
       UnicodeImplementation.Automatic means in this build. One setting
       (UnicodeEnvironment.Implementation) governs the segmenter and
       the normalizer together, so one symbol decides both. With the
       symbol undefined (the default), Automatic means the runtime's
       StringInfo and string.Normalize, the same place
       character-category data comes from, so a target framework added
       here tracks its own runtime with no extra wiring.
       INDUCTORPARSER_USE_BUNDLED_UNICODE makes Automatic mean the
       library's built-in UAX #29 segmenter and UAX #15 normalizer
       instead (Lexing/Unicode/GraphemeSegmentation.cs and
       Lexing/Unicode/UnicodeNormalization.cs, both implementing
       Unicode 16.0). The
       netstandard2.1 build defines it because the runtimes that load
       that build (Unity's Mono, IL2CPP) ship a StringInfo that
       predates UAX #29 and would tokenize incorrectly, and a
       string.Normalize that misses mappings and accepts ill-formed
       UTF-16. This is only the default: callers on any build can
       override it at startup by setting
       UnicodeEnvironment.Implementation before building grammars or
       parsing. Consequence for callers: a client and server that must
       agree on parse trees either run the same runtime or both opt
       into Bundled. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <DefineConstants>$(DefineConstants);INDUCTORPARSER_USE_BUNDLED_UNICODE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InductorParser.Tests" />
    <!-- The Unity IL2CPP smoke test asmdef produces an assembly named
         InductorParser.PlayModeTests and runs the same test sources as
         InductorParser.Tests (synced in by runil2cpptest.sh). The tests
         use internal members (NormalizedPositionMap, Rule.TraceLabel,
         and others), so this second IVT is required for the synced
         sources to compile under Unity. See docs/TestArchitecture.md. -->
    <InternalsVisibleTo Include="InductorParser.PlayModeTests" />
    <!-- The state-machine engine is an alternative evaluator that
         lives in its own repo and builds as a separate assembly, so
         consumers who don't need it can ship without it. It needs
         access to internal members on Lexer, Rule, Symbol, and
         ParseOptions because it's an alternative evaluator, not an
         external API consumer. -->
    <InternalsVisibleTo Include="InductorParser.StateMachine" />
    <!-- Tests for the state-machine engine need internal access too:
         EngineSelectionFixture flips the internal
         ParseOptions.DefaultUseAlternativeEvaluator /
         Rule.AlternativeEvaluator hooks to route Rule.Parse through
         the engine. Same rationale as InductorParser.PlayModeTests
         above. -->
    <InternalsVisibleTo Include="InductorParser.StateMachine.Tests" />
    <!-- Required-literal prefilter analysis (InductorParser.Prefilter,
         maintained alongside the state-machine engine) introspects
         rule types from outside the core assembly to derive
         a substring every successful match must contain. Neither parsing
         engine consults it; it exists for the rebar grep benchmark and
         any other caller that wants to pre-filter input before invoking
         the parser. Needs internal access to rule-type accessors
         (Rule.ExpectedText, OneOfRule.Set, etc.) and to
         TokenSet's HasMultiRuneGraphemes / TryGetBmpChars helpers. -->
    <InternalsVisibleTo Include="InductorParser.Prefilter" />
    <InternalsVisibleTo Include="InductorParser.RebarRunner" />
  </ItemGroup>

  <!-- Version numbers. Bump VersionMajor and VersionMinor by hand when
       a release calls for it. The build number is computed, not
       stored: the ComputeVersionFromGit target below sets it to the
       commit count of the branch being built (git rev-list count).
       That number comes straight from the shared .git database, so
       every worktree computes the same value for the same commit,
       there's no counter file to conflict on merge, and rebuilding the
       same commit always produces the same version.

       The three version attributes get different values on purpose.
       AssemblyVersion stays fixed at Major.Minor.0.0 because it's what
       .NET binding uses to decide whether two assemblies are the same,
       and moving it every commit would break every consumer that
       compiled against the previous build. FileVersion (what Explorer
       shows in file properties) gets the real Major.Minor.Build.
       InformationalVersion adds the short commit hash on the end
       (1.0.1059+d745f88) so the exact commit a DLL came from is
       readable from the file alone. When git isn't available (a build
       from a source tarball, for example) the build number falls back
       to 0 and the hash is left off. -->
  <PropertyGroup>
    <VersionMajor>1</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <!-- The SDK appends the full 40-character commit hash to
         InformationalVersion on its own when it detects a git repo,
         which would put the commit in twice. The target below already
         adds the short hash, so the automatic append is turned off. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="ComputeVersionFromGit"
          BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes;GenerateNuspec">
    <Exec Command="git rev-list --count HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="GitCommitCountExitCode" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
      <Output TaskParameter="ExitCode" PropertyName="GitCommitHashExitCode" />
    </Exec>
    <PropertyGroup>
      <GitCommitCount Condition="'$(GitCommitCountExitCode)' != '0'">0</GitCommitCount>
      <FileVersion>$(VersionMajor).$(VersionMinor).$(GitCommitCount)</FileVersion>
      <InformationalVersion>$(FileVersion)</InformationalVersion>
      <InformationalVersion Condition="'$(GitCommitHashExitCode)' == '0'">$(FileVersion)+$(GitCommitHash)</InformationalVersion>
      <AssemblyVersion>$(VersionMajor).$(VersionMinor).0.0</AssemblyVersion>
      <!-- The NuGet package takes the same Major.Minor.Build as the
           DLL. Set here, after the commit count is known, rather than
           at evaluation time where it would default to 1.0.0. -->
      <PackageVersion>$(FileVersion)</PackageVersion>
    </PropertyGroup>
  </Target>

  <!-- After building the netstandard2.1 DLL (the one Unity's IL2CPP
       scripting backend loads), drop it into the Unity IL2CPP smoke
       test project under src/InductorParser.Tests/Unity/Assets/Plugins/
       so the PlayMode smoke test assembly can reference it. The net8.0
       build is only consumed by dotnet test and isn't copied. -->
  <Target Name="CopyToUnity" AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(MSBuildThisFileDirectory)..\InductorParser.Tests\Unity\Assets\Plugins\" />
  </Target>

</Project>
