<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>InductorParser</RootNamespace>
    <AssemblyName>InductorParser</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Emit an XML doc file next to the DLL so IntelliSense can show
         /// doc comments to consumers who reference the assembly
         directly. CS1591 ("missing XML comment for publicly visible
         type or member") is suppressed because public API docs are
         being added type-by-type. Without this, every undocumented
         public member would fail the build under TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Grapheme segmentation policy: keep each build's Unicode
       environment internally consistent. By default a build takes
       segmentation from the runtime's StringInfo, the same place
       string.Normalize and character-category data come from, so a
       target framework added here tracks its own runtime with no extra
       wiring. Defining INDUCTORPARSER_USE_BUNDLED_SEGMENTATION opts a
       build into the library's bundled UAX #29 segmenter instead
       (Lexing/GraphemeSegmentation.cs, fixed at Unicode 15.0). The
       netstandard2.1 build opts in because the runtimes that load it
       (Unity's Mono, IL2CPP) ship a StringInfo that predates UAX #29
       and would tokenize incorrectly. Consequence for callers: a client
       and server that must agree on parse trees need to run on the same
       runtime. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <DefineConstants>$(DefineConstants);INDUCTORPARSER_USE_BUNDLED_SEGMENTATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InductorParser.Tests" />
    <!-- The Unity IL2CPP smoke test asmdef produces an assembly named
         InductorParser.PlayModeTests and runs the same test sources as
         InductorParser.Tests (synced in by runil2cpptest.sh). The tests
         use internal members (NormalizedPositionMap, Rule.TraceLabel,
         and others), so this second IVT is required for the synced
         sources to compile under Unity. See docs/TestArchitecture.md. -->
    <InternalsVisibleTo Include="InductorParser.PlayModeTests" />
    <!-- The state-machine engine in ExperimentalSrc/ ships as a
         separate assembly so consumers who don't need it can ship
         without it. It needs access to internal members on Lexer,
         Rule, Symbol, and ParseOptions because it's an alternative
         evaluator, not an external API consumer. -->
    <InternalsVisibleTo Include="InductorParser.StateMachine" />
    <!-- Tests for the state-machine engine need internal access too:
         EngineSelectionFixture flips the internal
         ParseOptions.DefaultUseAlternativeEvaluator /
         Rule.AlternativeEvaluator hooks to route Rule.Parse through
         the engine. Same rationale as InductorParser.PlayModeTests
         above. -->
    <InternalsVisibleTo Include="InductorParser.StateMachine.Tests" />
    <!-- Required-literal prefilter analysis (ExperimentalSrc/InductorParser.Prefilter)
         introspects rule types from outside the core assembly to derive
         a substring every successful match must contain. Neither parsing
         engine consults it; it exists for the rebar grep benchmark and
         any other caller that wants to pre-filter input before invoking
         the parser. Needs internal access to rule-type accessors
         (Rule.ExpectedText, OneOfRule.Set, etc.) and to
         TokenSet's HasMultiRuneGraphemes / TryGetBmpChars helpers. -->
    <InternalsVisibleTo Include="InductorParser.Prefilter" />
    <InternalsVisibleTo Include="InductorParser.RebarRunner" />
  </ItemGroup>

  <!-- After building the netstandard2.1 DLL (the one Unity's IL2CPP
       scripting backend loads), drop it into the Unity IL2CPP smoke
       test project under src/InductorParser.Tests/Unity/Assets/Plugins/
       so the PlayMode smoke test assembly can reference it. The net8.0
       build is only consumed by dotnet test and isn't copied. -->
  <Target Name="CopyToUnity" AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(MSBuildThisFileDirectory)..\InductorParser.Tests\Unity\Assets\Plugins\" />
  </Target>

</Project>
